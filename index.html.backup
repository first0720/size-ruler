          <tr><th scope="row">245</th><td>24.5</td><td>6.5</td><td>8</td><td>5.5</td><td>39</td></tr>
          <tr><th scope="row">250</th><td>25.0</td><td>7</td><td>8.5</td><td>6</td><td>40</td></tr>
          <tr><th scope="row">255</th><td>25.5</td><td>7.5</td><td>9</td><td>6.5</td><td>40.5</td></tr>
          <tr><th scope="row">260</th><td>26.0</td><td>8</td><td>9.5</td><td>7</td><td>41</td></tr>
          <tr><th scope="row">265</th><td>26.5</td><td>8.5</td><td>10</td><td>7.5</td><td>42</td></tr>
          <tr><th scope="row">270</th><td>27.0</td><td>9</td><td>10.5</td><td>8</td><td>42.5</td></tr>
          <tr><th scope="row">275</th><td>27.5</td><td>9.5</td><td>11</td><td>8.5</td><td>43</td></tr>
